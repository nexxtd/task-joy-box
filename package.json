{
  "name": "task-joy-box",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint \"{src,server,shared}/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "dev:server": "npx nodemon --exec npx tsx server/index.ts",
    "dev:client": "vite",
    "dev:tunnel": "npx wrangler tunnel quick-start http://localhost:5173",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:tunnel:full": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:tunnel\"",
    "db:push": "npx drizzle-kit push",
    "build:server": "npx tsc -p tsconfig.server.json && node scripts/write-server-package.cjs",
    "build:client": "tsc -b && vite build",
    "build": "npm run build:client && npm run build:server",
    "prestart": "node scripts/write-server-package.cjs",
    "start": "cross-env NODE_ENV=production node dist-server/server/index.js"
  },
