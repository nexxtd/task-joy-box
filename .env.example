ADMIN_EMAILS=admin@example.com
BACKEND_URL=https://your-app.onrender.com
CF_TUNNEL_URL=
CROSS_SITE_COOKIES=true
DATABASE_URL=postgresql://user:password@host:5432/dbname
ENCRYPTION_KEY=generate-a-random-64-char-hex-string
FRONTEND_URL=https://your-app.onrender.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
HOST=localhost:3001
JWT_SECRET=generate-a-random-64-char-hex-string
NODE_ENV=production
OPENROUTER_API_KEY=sk-or-v1-your-key-here
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
PORT=3001
RENDER_EXTERNAL_URL=
SESSION_SECRET=generate-a-random-64-char-hex-string
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Email (choose one provider)
# Option A — Resend (recommended): https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@yourdomain.com
FRONTEND_URL=https://your-app.onrender.com
# Option B — SMTP (Gmail, Brevo, SES, etc)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
SMTP_SERVICE=gmail
